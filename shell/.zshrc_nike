#
# AWS CLI and gimme-aws-creds CLI stuff:
#   https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-envvars.html
#   https://github.com/jcreyf/gimme-aws-creds/
#   https://github.com/Nike-Inc/gimme-aws-creds
#

# Names of AWS_PROFILEs in the Okta config-file:
# /> grep "\[" ~/.okta_aws_login_config | sed 's/[][]//g'
#   waffle
#   waffle-nsp
#   eap-preprod
#   eap-prod
# Names of profiles in AWS credentials:
# /> grep "\[" ~/.aws/credentials | sed 's/[][]//g'
#   waffle-nsp
#   default 
# Set whatever profile we had set before:
export AWS_PROFILE=$(cat ${HOME}/.aws/.last_profile 2>/dev/null)
export AWS_REGION=$(cat ${HOME}/.aws/.last_region 2>/dev/null)

# List all the AWS profiles that we have configured in gimme-aws-creds:
aws_profiles()
{
  local _profiles=$(grep cred_profile ~/.okta_aws_login_config | grep -v default | cut -d' ' -f3 | sort -h)
  for _profile in ${_profiles[@]} ; do
    echo "export AWS_PROFILE=${_profile}"
  done
  printf "\nexport AWS_REGION=us-west-2\nexport AWS_REGION=us-east-1\n\n"
}
alias awsprofiles=aws_profiles

# Get AWS credential to locally test Cerberus SDK code 
# (the SDK expects a 'DEFAULT' credential in "~/.aws/credentials" and we need to get it for an IAM ARN that has permissions on the Cerberus SDB that we're trying to work with)
alias cerberuscreds="gimme-aws-creds --roles arn:aws:iam::497349380054:role/NIKE.SSO.AdminRole"

# NSP1 K8s aliases:
alias nsp1_profiles="cd /Users/JCREYF/data/nike/platforms/nsp1/profiles/"
alias nsp1_clusters="grep -l 'KES_CLUSTER_NAME=\"' /Users/JCREYF/data/nike/platforms/nsp1/profiles/* | rev | cut -d'/' -f1 | rev | cut -d'.' -f1"
alias nsp1_sbx_west_prs="source /Users/JCREYF/data/nike/platforms/nsp1/profiles/nsp1_sbx_west_prs.profile"
alias nsp1_dev_west_gcl="source /Users/JCREYF/data/nike/platforms/nsp1/profiles/nsp1_dev_west_gcl.profile"
alias nsp1_dev_west_max="source /Users/JCREYF/data/nike/platforms/nsp1/profiles/nsp1_dev_west_max.profile"
alias nsp1_dev_west_qac="source /Users/JCREYF/data/nike/platforms/nsp1/profiles/nsp1_dev_west_qac.profile"
alias nsp1_dev_east_drc="source /Users/JCREYF/data/nike/platforms/nsp1/profiles/nsp1_dev_east_drc.profile"
alias nsp1_qa_west_gcl="source /Users/JCREYF/data/nike/platforms/nsp1/profiles/nsp1_qa_west_gcl.profile"
alias nsp1_prd_west_gcl="source /Users/JCREYF/data/nike/platforms/nsp1/profiles/nsp1_prd_west_gcl.profile"
alias nsp1_prd_west_gcl2="source /Users/JCREYF/data/nike/platforms/nsp1/profiles/nsp1_prd_west_gcl2.profile"
alias nsp1_prd_east_drc="source /Users/JCREYF/data/nike/platforms/nsp1/profiles/nsp1_prd_east_drc.profile"

# App to generate a Bearer token for accessing NSP Kong endpoints for a given environment:
#   https://github.com/nike-streaming-platform/nsp/tree/development/scripts/utils/kong/okta
# pip install -r /Users/JCREYF/data/nike/git/nike-streaming-platform/nsp/scripts/utils/kong/okta/requirements.txt
alias nsp1_bearertoken_dev="python /Users/JCREYF/data/nike/git/nike-streaming-platform/nsp/scripts/utils/kong/okta/gimme_nsp_token.py --export --environment dev"
alias nsp1_bearertoken_qa="python /Users/JCREYF/data/nike/git/nike-streaming-platform/nsp/scripts/utils/kong/okta/gimme_nsp_token.py --export --environment qa"
alias nsp1_bearertoken_prd="python /Users/JCREYF/data/nike/git/nike-streaming-platform/nsp/scripts/utils/kong/okta/gimme_nsp_token.py --export --environment prd"

# Generic aliases:
alias cdgit='cd ~/data/nike/git/'
alias cdfus='cd ~/data/nike/git/nike-fusion/'
alias cdme='cd ~/data/nike/git/jcreyf_nike/'
alias cdtf='cd ~/data/nike/git/jcreyf_nike/NSP/nsp3/KafkaStreams/'
alias cdnsp1='cd ~/data/nike/git/nike-streaming-platform/'
alias cdnsp3='cd ~/data/nike/git/nike-near-real-time/'
alias cdnmk='cd ~/data/nike/git/nike-managed-kafka/'

# Alias to OpenLens app:
alias lens='/Applications/Lens.app/Contents/MacOS/Lens'

# NSP3 specific stuff:
export NSP3_API_URL_LOCAL=http://localhost:8080
export NSP3_API_URL_DEV=https://api.nrtd-dev.platforms.nike.com
export NSP3_API_URL_PRD=https://api.nrtd.platforms.nike.com
export NSP3_API_URL=${NSP3_API_URL_PRD}

export NSP3_ENV_DEV="dev"
export NSP3_ENV_STAGING="staging"
export NSP3_ENV_PRD="production"
export NSP3_ENV=${NSP3_ENV_PRD}
