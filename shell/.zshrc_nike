#!/bin/zsh

#
# Function for a dynamic Terraform prompt:
#
function terraform_prompt {
  # Only build a terraform prompt if there's a .terraform sub-dir in the current directory
  if [ -d ${PWD}/.terraform ] ; then
    local _tf_workspace
    local _tf_log
    local _debugFlag=""
    # We're going to get a lot of extra garbage if we have the $TF_LOG env variable set.
    # Remove it if set but keep track of it, so we can set it back as soon as we have the info we need!
    test -z ${TF_LOG} ; local _logFlag=$?
    # Remove the log level if set
    if [[ $_logFlag -eq 1 ]] ; then 
      _tf_log=${TF_LOG};
      _debugFlag=" (TF_LOG=$_tf_log)"   # Show the set debug-level on the prompt
      export TF_LOG=""; 
    fi
    # Get the name of the current workspace in Terraform
    local _tf_workspace=$(terraform workspace show) 2>/dev/null
    # Restore the log level if it was set
    if [[ $_logFlag -eq 1 ]] ; then export TF_LOG=$_tf_log; fi
    echo -e "[\e[1;37mTerraform -> workspace: \e[41;93;3m${_tf_workspace}\e[0m${_debugFlag} - AWS CLI pointing to: \e[41;93;3m${AWS_PROFILE}\e[0m]"
  fi
}

alias tf='/Users/jcreyf/data/nike/platforms/tools/terraform/tf'

#
# Function for a dynamic AWS CLI prompt:
#
function aws_prompt {
  local _credentials_file=${HOME}/.aws/credentials
  local _last_profile_file=${HOME}/.aws/.last_profile
  local _last_region_file=${HOME}/.aws/.last_region
  local _aws_cli=$(aws --version | cut -d' ' -f1 | cut -d'/' -f2 2>/dev/null)
  local _aws_region
  local _aws_profile
  local _aws_account
  local _aws_role
  local _session_state_color
  # Keep track of the age of ~/.aws/credentials
  # We use this to set color indication on the profile name (red = expired session; green = probably still valid)
  if [ -f ${_credentials_file} ] ; then
    _credentials_file_age=$(($(date +%s) - $(date -r ${_credentials_file} +%s)))
    if [ ${_credentials_file_age} -lt 3600 ] ; then
      _session_state_color="\e[42;1m"
    else
      _session_state_color="\e[41;1m"
    fi
  fi
  if [[ -z "${AWS_REGION}" ]] ; then
    _aws_region=" - region:\e[41;93mnot set\e[0m"
    # Remove the last region file (if we have one):
    rm -f ${_last_region_file} 2>/dev/null
  else
    # Update the last region file if it has a different region in it (or if it doesn't exist):
    if [[ "$(cat ${_last_region_file} 2>/dev/null)" != "${AWS_REGION}" ]] ; then
      echo ${AWS_REGION} > ${_last_region_file}
    fi
    _aws_region=" - region:\e[1;35m${AWS_REGION}\e[0m"
  fi
  if [[ -z "${AWS_PROFILE}" ]] ; then
    _aws_profile="\e[41;93mnot set\e[0m"
    # Remove the last profile file (if we have one):
    rm -f ${_last_profile_file} 2>/dev/null
  else
    # Update the last profile file if it has a different profile in it (or if it doesn't exist):
    if [[ "$(cat ${_last_profile_file} 2>/dev/null)" != "${AWS_PROFILE}" ]] ; then
      echo ${AWS_PROFILE} > ${_last_profile_file}
    fi
    # We need to parse details for the selected profile from the config-file:
    local _creds_cfg_file=${HOME}/.okta_aws_login_config
    _aws_profile="${_session_state_color}${AWS_PROFILE}\e[0m"
    # Find the line number of where the profile section begins in the config-file:
    local _section_line=$(awk "/\[${AWS_PROFILE}\]/{ print NR }" ${_creds_cfg_file})
    # Need to list the profile names if the one in $AWS_PROFILE is not found:
    if [[ "${_section_line}" == "" ]] ; then
      echo -e "[\e[1;37maws-cli:\e[41;93mprofile '${AWS_PROFILE}' not found in ${_creds_cfg_file}! Please select from the following profiles:\e[0m]"
      aws_profiles
      return
    fi
    # Find the line where the next section begins:
    local _next_section_line=$(awk "NR > ${_section_line} && /\[.*\]/{ print NR; exit; }" ${_creds_cfg_file})
    # There's no output if this was the last section in the file!
    if [[ "${_next_section_line}" == "" ]] ; then
      # Get the number of lines on the file instead to get the last line number:
      _next_section_line=$(wc -l ${_creds_cfg_file} | awk '{ print $1 }')
    fi
    # Find the line that has the 'aws_rolename' setting in the active profile section:
    local _role_line=$(awk "NR > ${_section_line} && NR < ${_next_section_line} && /^aws_rolename/{ print $1 }" ${_creds_cfg_file})
    # We may not have a rolename in the config-file!
    if [[ "${_role_line}" == *"arn:aws"* ]] ; then
      # This looks like a valid arn.  Parse out the AWS account number and IAM Role that will be used:
      local _account=$(echo ${_role_line} | cut -d":" -f5)
      local _role=$(echo ${_role_line} | cut -d"/" -f2)
      # Generate the text that will be used in the prompt:
      _aws_account=" - account:\e[1;35m${_account}\e[0m"
      _aws_role=" - role:\e[1;35m${_role}\e[0m"
    else
      # We don't have a rolename.
      # The user needs to select a role when getting new session tokens through gimme-aws-creds.
      # We may have valid session tokens if the aws credentials file is less than 60 minutes old.
      # If so, then we should be able to pull the missing fields from the aws cli.
      local _last_session_details="${HOME}/.aws/.last_session_details"
      if [ "$(find ${_credentials_file} -mmin -60)" ] ; then
        # We may have a valid session.
        # See if we have a session details file that is also less than 60 minutes old.
        if [ -f ${_last_session_details} ] && [ "$(find ${_last_session_details} -mmin -60)" ] ; then
          # Yes -> read the fields from the file:
          _account=$(grep "AWS_ACCOUNT=" ${_last_session_details} | cut -d'=' -f2 2>/dev/null)
          _role=$(grep "AWS_ROLE=" ${_last_session_details} | cut -d'=' -f2 2>/dev/null)
        else
          # No -> try get the data from aws cli and write to file:
          rm -f ${_last_session_details} 2>/dev/null
          # Now try to get the missing details from the AWS CLI and write to the last details file:
          _account=$(aws sts get-caller-identity | jq -r '.Account' 2>/dev/null)
          _role=$(aws sts get-caller-identity | jq -r '.Arn' | cut -d'/' -f2 2>/dev/null)
          echo "AWS_ACCOUNT=${_account}" > ${_last_session_details}
          echo "AWS_ROLE=${_role}" >> ${_last_session_details}
        fi
        _aws_account=" - account:\e[41;93m${_account:-"unknown"}\e[0m"
        _aws_role=" - role:\e[41;93m${_role:-"unknown"}\e[0m"
        eval "export AWS_ACCOUNT=${_account}"
        eval "export AWS_ROLE=${_role}"
      else
        # The credentials file is older than 1 hour and thus all tokens are expired!
        rm -f ${_last_session_details} 2>/dev/null
        _aws_account=" - account:\e[41;93mnot set\e[0m"
        _aws_role=" - role:\e[41;93mnot set\e[0m"
      fi
    fi
  fi
  echo -e "[\e[1;37maws-cli:\e[1;35m${_aws_cli}\e[0m${_aws_region} - profile:${_aws_profile}${_aws_account}${_aws_role}]"
}

#
# Function for a dynamic Kubernetes prompt
#
function k8s_prompt {
  local _config=~/.kube/config
  if [ -f $_config ] ; then
    local _cluster_script_dir="/Users/JCREYF/data/nike/platforms/k8s_profiles"
    local _cluster_name=$(kubectl config view --minify -o jsonpath='{.clusters[].name}')
    local _cluster_name_base=$(echo ${_cluster_name} | rev | cut -d'/' -f1 | rev)
    local _cluster_script_file=$(grep -l "KES_CLUSTER_NAME=\"${_cluster_name_base}\"" ${_cluster_script_dir}/* | head -n1)
    if [ $? -ne 0 ] || [ -z "${_cluster_script_file}" ] ; then
      _profile=""
      echo -e "[\e[41;1mNo k8s profile in ${_cluster_script_dir} for cluster '${_cluster_name_base}'\e[0m]"
      return
    fi
    local _profile=$(basename ${_cluster_script_file})
    local _profile_name="${_profile%.*}"
    echo -e "[\e[1;37mK8s Cluster:\e[1;35m${_cluster_name}\e[0m (profile:\e[1;35m${_cluster_script_file}\e[0m)]"
  fi
}

